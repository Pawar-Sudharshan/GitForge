# ApnaGit / GitForge Backend Configuration Example
# Copy this file to .env and configure your values

# MongoDB Connection
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net"
PORT=5000

# AWS S3 Remote Storage Configuration
S3_BUCKET_NAME=gitbucket0
AWS_REGION=ap-south-1

# Optional default repository ID for CLI push/pull
APNAGIT_REPO_ID=my-project-repo
